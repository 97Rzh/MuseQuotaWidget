<Window x:Class="MuseQuotaWidget.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="360" Height="240" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20">
    <TextBlock Text="刷新频率" FontSize="14" FontWeight="Bold" />
    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#666666"
               Text="悬浮窗每隔一段时间自动从 Muse 读取一次额度。读的是额度接口，不是对话，不耗对话 token；过于频繁可能触发限流，建议 5 分钟以上。" />
    <Slider x:Name="IntervalSlider" Margin="0,16,0,0"
            Minimum="1" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True"
            ValueChanged="IntervalSlider_ValueChanged" />
    <DockPanel Margin="0,4,0,0">
      <TextBlock Text="1 分钟" Foreground="#999999" />
      <TextBlock DockPanel.Dock="Right" Text="60 分钟" Foreground="#999999" />
    </DockPanel>
    <TextBlock x:Name="IntervalValueText" Margin="0,12,0,0" FontSize="16"
               HorizontalAlignment="Center" Text="每 5 分钟刷新" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="确定" Width="72" Padding="0,4" Click="Ok_Click" />
      <Button Content="取消" Width="72" Padding="0,4" Margin="8,0,0,0" Click="Cancel_Click" />
    </StackPanel>
  </StackPanel>
</Window>
