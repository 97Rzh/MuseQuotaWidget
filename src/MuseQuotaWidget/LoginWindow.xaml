<Window x:Class="MuseQuotaWidget.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="连接 Muse" Width="900" Height="700"
        MinWidth="600" MinHeight="450">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <wv2:WebView2 x:Name="WebView" Grid.Row="0" />
    <DockPanel Grid.Row="1" Margin="16,12" LastChildFill="True">
      <Button x:Name="VerifyButton" DockPanel.Dock="Right" Padding="16,6"
              Content="验证登录并读取额度" Click="VerifyButton_Click" />
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                 Foreground="#666666" Margin="0,0,12,0"
                 Text="请在上方完成 Muse 网页登录，再点击验证连接。登录信息仅保存在本机。" />
    </DockPanel>
  </Grid>
</Window>
