<Window x:Class="MuseQuotaWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="240" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True">
  <Window.Resources>
    <!-- RamanVista 的语义色（Resources/Styles/ThemeColors.xaml，深色主题），
         不引 MaterialDesign 包，只复刻颜色与控件样式，构建风险小。 -->
    <SolidColorBrush x:Key="AppThemeSurfaceBrush" Color="#2B2D33" />
    <SolidColorBrush x:Key="AppThemeSurfaceStrongBrush" Color="#25272D" />
    <SolidColorBrush x:Key="AppThemeSurfaceAlternateBrush" Color="#3A3D45" />
    <SolidColorBrush x:Key="AppThemeInputBackgroundBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="AppThemeBorderBrush" Color="#606060" />
    <SolidColorBrush x:Key="AppThemeTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppThemeSecondaryTextBrush" Color="#C9CDD6" />
    <SolidColorBrush x:Key="AppThemeMutedTextBrush" Color="#AEB4C0" />
    <SolidColorBrush x:Key="AppThemeSubtleTextBrush" Color="#8E96A3" />
    <SolidColorBrush x:Key="AppThemeAccentBrush" Color="#4FC3F7" />
    <SolidColorBrush x:Key="AppThemeAccentSurfaceBrush" Color="#1E3A4A" />
    <SolidColorBrush x:Key="AppThemeAccentContrastBrush" Color="#101010" />
    <SolidColorBrush x:Key="AppThemeHoverBrush" Color="#36414D" />

    <!-- RamanVista App.xaml 的 Primary / Secondary 按钮，补上圆角模板
         （原样式只给颜色，WPF 默认按钮模板没有圆角）。 -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource AppThemeAccentBrush}" />
      <Setter Property="Foreground" Value="{StaticResource AppThemeAccentContrastBrush}" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#6ED0F9" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.55" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- 不用 BasedOn：基样式的 IsMouseOver 触发器会和派生样式的
         同名触发器同时生效，次要按钮悬停时可能被主按钮的浅蓝盖掉，
         白字在浅蓝上看不清，所以三套按钮各自独立写触发器。 -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource AppThemeSurfaceAlternateBrush}" />
      <Setter Property="Foreground" Value="{StaticResource AppThemeTextBrush}" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderBrush" Value="{StaticResource AppThemeBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource AppThemeHoverBrush}" />
          <Setter Property="BorderBrush" Value="{StaticResource AppThemeAccentBrush}" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.55" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource AppThemeSurfaceAlternateBrush}" />
      <Setter Property="Foreground" Value="#F87171" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderBrush" Value="{StaticResource AppThemeBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#422A2A" />
          <Setter Property="BorderBrush" Value="#F87171" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.55" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="GearButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="14">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#33FFFFFF" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- RamanVista FormControlStyles 的滑块（去掉与本窗无关的滚动条引用）。 -->
    <Style x:Key="FormSliderRepeatButtonStyle" TargetType="RepeatButton">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FormSliderDecreaseButtonStyle" TargetType="RepeatButton">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Grid Background="Transparent">
              <Border Height="4" VerticalAlignment="Center"
                      Background="{DynamicResource AppThemeAccentBrush}" CornerRadius="2" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FormSliderThumbStyle" TargetType="Thumb">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Grid Width="18" Height="18" Background="Transparent">
              <Border x:Name="KnobHalo" Width="18" Height="18" CornerRadius="9" Background="Transparent" />
              <Border x:Name="Knob" Width="12" Height="12" CornerRadius="6"
                      Background="{DynamicResource AppThemeAccentBrush}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="KnobHalo" Property="Background" Value="{DynamicResource AppThemeAccentSurfaceBrush}" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="KnobHalo" Property="Background" Value="{DynamicResource AppThemeAccentSurfaceBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FormSliderStyle" TargetType="Slider">
      <Setter Property="Height" Value="24" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid>
              <Border Height="4" VerticalAlignment="Center"
                      Background="{DynamicResource AppThemeSurfaceAlternateBrush}" CornerRadius="2" />
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge"
                                Style="{StaticResource FormSliderDecreaseButtonStyle}" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge"
                                Style="{StaticResource FormSliderRepeatButtonStyle}" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource FormSliderThumbStyle}" />
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <!-- 悬浮窗本体保持不变：圆角卡片 + 百分比 + 主条 + 节奏 + 时间。
       右键菜单已删，取而代之的是悬停才显示的齿轮按钮与内置设置面板。 -->
  <Border x:Name="Card"
          CornerRadius="16" Padding="16,14,16,12"
          Background="#E81F2937" BorderBrush="#33FFFFFF" BorderThickness="1"
          MouseLeftButtonDown="Card_MouseLeftButtonDown"
          MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- 额度区：正常时占满 208 宽居中显示；设置展开时窗口变宽，
           这一列自动剩 180 宽，额度区就缩到了左上角（见 SetQuotaMini）。 -->
      <StackPanel x:Name="QuotaPanel" Grid.Column="0" VerticalAlignment="Top">
        <TextBlock x:Name="RemainingText" FontSize="44" FontWeight="Bold" Foreground="#4ADE80"
                   HorizontalAlignment="Center" Text="—" />
        <ProgressBar x:Name="RemainingBar" Height="10" Minimum="0" Maximum="100" Value="0" Margin="0,8,0,0"
                     Foreground="#22C55E" Background="#33FFFFFF" BorderThickness="0" />
        <!-- 第二版用量节奏控件：主条下方，重置时间上方。
             不重复显示已用%：只显示与平均线的偏差。
             渐变刻度绿→黄→红，中央白线 = 平均线，白点 = 实际偏差，
             偏左慢、偏右快；下方文字写快/慢与预计用完。
             重置时间拿不到时整个面板隐藏，只剩百分比、主条与时间。 -->
        <StackPanel x:Name="PacePanel" Visibility="Collapsed" Margin="0,8,0,0">
          <Grid x:Name="PaceScaleGrid" Height="22" SizeChanged="PaceScaleGrid_SizeChanged">
            <Border Height="14" VerticalAlignment="Center" CornerRadius="7">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#22C55E" Offset="0" />
                  <GradientStop Color="#EAB308" Offset="0.5" />
                  <GradientStop Color="#EF4444" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Rectangle Width="2" Height="22" Fill="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Ellipse x:Name="PaceDot" Width="16" Height="16" Fill="White"
                     Stroke="#111827" StrokeThickness="2"
                     HorizontalAlignment="Left" VerticalAlignment="Center" />
          </Grid>
          <Grid Margin="0,2,0,0">
            <TextBlock FontSize="10" Foreground="#9CA3AF"
                       HorizontalAlignment="Left" Text="慢" />
            <TextBlock FontSize="10" Foreground="#9CA3AF"
                       HorizontalAlignment="Center" Text="平均" />
            <TextBlock FontSize="10" Foreground="#9CA3AF"
                       HorizontalAlignment="Right" Text="快" />
          </Grid>
          <TextBlock x:Name="PaceText" FontSize="12" FontWeight="Bold"
                     HorizontalAlignment="Center" Margin="0,4,0,0" Text="—" />
        </StackPanel>
        <TextBlock x:Name="TimeText" FontSize="11" Foreground="#9CA3AF"
                   HorizontalAlignment="Center" Margin="0,8,0,0" Text="未登录" />
      </StackPanel>

      <!-- 内置设置面板：原右键菜单的全部内容，RamanVista 卡片风格。
           正常时折叠，展开时占 300 宽，窗口随之变宽到 528。 -->
      <Border x:Name="SettingsPanel" Grid.Column="1" Visibility="Collapsed"
              Width="300" Margin="16,0,0,0" VerticalAlignment="Top"
              Background="{StaticResource AppThemeSurfaceStrongBrush}"
              BorderBrush="{StaticResource AppThemeBorderBrush}" BorderThickness="1"
              CornerRadius="12" Padding="16">
        <StackPanel>
          <TextBlock Text="设置" FontSize="16" FontWeight="Bold"
                     Foreground="{StaticResource AppThemeTextBrush}" />

          <TextBlock Text="账号" FontSize="12" FontWeight="Bold" Margin="0,16,0,6"
                     Foreground="{StaticResource AppThemeMutedTextBrush}" />
          <TextBlock x:Name="LoginStatusText" FontSize="13" Margin="0,0,0,8"
                     Foreground="{StaticResource AppThemeSecondaryTextBrush}" Text="未登录" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="LoginButton" Grid.Column="0" Content="登录 Muse…"
                    Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,4,0" Click="Login_Click" />
            <Button x:Name="LogoutButton" Grid.Column="1" Content="退出登录"
                    Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0" Click="Logout_Click" />
          </Grid>

          <TextBlock Text="数据" FontSize="12" FontWeight="Bold" Margin="0,16,0,6"
                     Foreground="{StaticResource AppThemeMutedTextBrush}" />
          <Button Content="刷新数据" Style="{StaticResource SecondaryButtonStyle}" Click="Refresh_Click" />

          <TextBlock Text="刷新频率" FontSize="12" FontWeight="Bold" Margin="0,16,0,6"
                     Foreground="{StaticResource AppThemeMutedTextBrush}" />
          <Slider x:Name="IntervalSliderPanel" Style="{StaticResource FormSliderStyle}"
                  Minimum="1" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True"
                  ValueChanged="IntervalSliderPanel_ValueChanged" />
          <TextBlock x:Name="IntervalValueTextPanel" FontSize="14" Margin="0,4,0,0"
                     HorizontalAlignment="Center" Text="每 5 分钟刷新"
                     Foreground="{StaticResource AppThemeTextBrush}" />
          <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11"
                     Foreground="{StaticResource AppThemeMutedTextBrush}"
                     Text="读的是额度接口，不是对话，不耗对话 token；过于频繁可能触发限流，建议 5 分钟以上。拖动滑块立即生效，不用点确定。" />

          <TextBlock Text="显示" FontSize="12" FontWeight="Bold" Margin="0,16,0,6"
                     Foreground="{StaticResource AppThemeMutedTextBrush}" />
          <CheckBox x:Name="TopmostCheckBox" Content="始终置顶" FontSize="13"
                    Foreground="{StaticResource AppThemeTextBrush}" Click="TopmostCheckBox_Click" />

          <TextBlock Text="其他" FontSize="12" FontWeight="Bold" Margin="0,16,0,6"
                     Foreground="{StaticResource AppThemeMutedTextBrush}" />
          <Button Content="打开诊断日志" Style="{StaticResource SecondaryButtonStyle}" Click="OpenDebugLog_Click" />
          <Button Content="退出软件" Style="{StaticResource DangerButtonStyle}" Margin="0,8,0,0" Click="Exit_Click" />

          <Button Content="完成" Style="{StaticResource PrimaryButtonStyle}" Margin="0,16,0,0" Click="Complete_Click" />
        </StackPanel>
      </Border>

      <!-- 齿轮按钮：只在鼠标悬停到悬浮窗上时显示，平时不显示。
           展开时它仍在窗体右上角，点它或点面板里的“完成”都能收起。 -->
      <Button x:Name="SettingsButton" Grid.ColumnSpan="2" Visibility="Collapsed"
              Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top"
              Style="{StaticResource GearButtonStyle}" Click="SettingsButton_Click">
        <TextBlock Text="⚙" FontSize="16" Foreground="#9CA3AF" />
      </Button>
    </Grid>
  </Border>
</Window>
