<Window x:Class="MuseQuotaWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Muse 额度"
        Width="300" Height="248"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True">
  <Border x:Name="Card"
          CornerRadius="16" Padding="16,14,16,12"
          Background="#E81F2937" BorderBrush="#33FFFFFF" BorderThickness="1"
          MouseLeftButtonDown="Card_MouseLeftButtonDown">
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem Header="刷新数据" Click="Refresh_Click" />
        <MenuItem Header="登录 Muse…" Click="Login_Click" />
        <MenuItem Header="退出登录" Click="Logout_Click" />
        <MenuItem Header="设置刷新频率…" Click="Settings_Click" />
        <MenuItem x:Name="TopmostMenuItem" Header="始终置顶" IsCheckable="True" IsChecked="True" Click="Topmost_Click" />
        <MenuItem Header="打开诊断日志" Click="OpenDebugLog_Click" />
        <Separator />
        <MenuItem Header="退出" Click="Exit_Click" />
      </ContextMenu>
    </Border.ContextMenu>
    <StackPanel>
      <DockPanel>
        <Button DockPanel.Dock="Right" Width="24" Height="24" Margin="8,0,0,0"
                Content="↻" FontSize="14" Foreground="#9CA3AF"
                Background="Transparent" BorderThickness="0"
                ToolTip="刷新数据" Click="Refresh_Click" />
        <TextBlock DockPanel.Dock="Right" TextAlignment="Right" VerticalAlignment="Center"
                   FontSize="12" Foreground="#9CA3AF" Text="" x:Name="PlanText" />
        <TextBlock Text="Muse 额度" FontSize="13" Foreground="#9CA3AF" VerticalAlignment="Center" />
      </DockPanel>

      <StackPanel Orientation="Horizontal" Margin="0,6,0,2" VerticalAlignment="Bottom">
        <TextBlock Text="剩余" FontSize="14" Foreground="#D1D5DB" VerticalAlignment="Bottom" Margin="0,0,6,6" />
        <TextBlock x:Name="RemainingText" FontSize="40" FontWeight="Bold" Foreground="#4ADE80" Text="—" />
        <TextBlock Text="周额度" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Bottom" Margin="6,0,0,6" />
      </StackPanel>

      <ProgressBar x:Name="RemainingBar" Height="8" Minimum="0" Maximum="100" Value="0"
                   Foreground="#22C55E" Background="#33FFFFFF" BorderThickness="0" />

      <DockPanel Margin="0,10,0,0">
        <TextBlock DockPanel.Dock="Right" x:Name="ResetText" FontSize="12" Foreground="#9CA3AF" Text="重置时间未知" />
        <TextBlock x:Name="DetailText" FontSize="13" Foreground="#E5E7EB" Text="右键登录 Muse 后显示实时额度" />
      </DockPanel>

      <Border Height="1" Background="#22FFFFFF" Margin="0,10,0,10" />

      <DockPanel>
        <TextBlock DockPanel.Dock="Right" x:Name="AdditionalText" FontSize="13" Foreground="#E5E7EB" Text="未知" />
        <TextBlock Text="额外词元" FontSize="13" Foreground="#D1D5DB" />
      </DockPanel>
      <ProgressBar x:Name="AdditionalBar" Height="6" Minimum="0" Maximum="100" Value="0" Margin="0,6,0,0"
                   Foreground="#38BDF8" Background="#33FFFFFF" BorderThickness="0" />

      <TextBlock x:Name="StatusText" Margin="0,10,0,0" FontSize="11" Foreground="#6B7280"
                 Text="未登录 Muse，右键登录 · 拖动可移动" />
    </StackPanel>
  </Border>
</Window>
