<Window x:Class="MuseQuotaWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="240" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True">
  <Border x:Name="Card"
          CornerRadius="16" Padding="16,14,16,12"
          Background="#E81F2937" BorderBrush="#33FFFFFF" BorderThickness="1"
          MouseLeftButtonDown="Card_MouseLeftButtonDown">
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem Header="刷新数据" Click="Refresh_Click" />
        <MenuItem Header="登录 Muse…" Click="Login_Click" />
        <MenuItem Header="退出登录" Click="Logout_Click" />
        <MenuItem Header="设置刷新频率…" Click="Settings_Click" />
        <MenuItem x:Name="TopmostMenuItem" Header="始终置顶" IsCheckable="True" IsChecked="True" Click="Topmost_Click" />
        <MenuItem Header="打开诊断日志" Click="OpenDebugLog_Click" />
        <Separator />
        <MenuItem Header="退出" Click="Exit_Click" />
      </ContextMenu>
    </Border.ContextMenu>
    <StackPanel>
      <TextBlock x:Name="RemainingText" FontSize="44" FontWeight="Bold" Foreground="#4ADE80"
                 HorizontalAlignment="Center" Text="—" />
      <ProgressBar x:Name="RemainingBar" Height="10" Minimum="0" Maximum="100" Value="0" Margin="0,8,0,0"
                   Foreground="#22C55E" Background="#33FFFFFF" BorderThickness="0" />
      <!-- 第二版用量节奏控件：主条下方，重置时间上方。
           不重复显示已用%：只显示与平均线的偏差。
           渐变刻度绿→黄→红，中央白线 = 平均线，白点 = 实际偏差，
           偏左慢、偏右快；下方文字写快/慢与预计用完。
           重置时间拿不到时整个面板隐藏，只剩百分比、主条与时间。 -->
      <StackPanel x:Name="PacePanel" Visibility="Collapsed" Margin="0,8,0,0">
        <Grid x:Name="PaceScaleGrid" Height="22" SizeChanged="PaceScaleGrid_SizeChanged">
          <Border Height="14" VerticalAlignment="Center" CornerRadius="7">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#22C55E" Offset="0" />
                <GradientStop Color="#EAB308" Offset="0.5" />
                <GradientStop Color="#EF4444" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <Rectangle Width="2" Height="22" Fill="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Ellipse x:Name="PaceDot" Width="16" Height="16" Fill="White"
                   Stroke="#111827" StrokeThickness="2"
                   HorizontalAlignment="Left" VerticalAlignment="Center" />
        </Grid>
        <Grid Margin="0,2,0,0">
          <TextBlock FontSize="10" Foreground="#9CA3AF"
                     HorizontalAlignment="Left" Text="慢" />
          <TextBlock FontSize="10" Foreground="#9CA3AF"
                     HorizontalAlignment="Center" Text="平均" />
          <TextBlock FontSize="10" Foreground="#9CA3AF"
                     HorizontalAlignment="Right" Text="快" />
        </Grid>
        <TextBlock x:Name="PaceText" FontSize="12" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,4,0,0" Text="—" />
      </StackPanel>
      <TextBlock x:Name="TimeText" FontSize="11" Foreground="#9CA3AF"
                 HorizontalAlignment="Center" Margin="0,8,0,0" Text="未登录" />
    </StackPanel>
  </Border>
</Window>
